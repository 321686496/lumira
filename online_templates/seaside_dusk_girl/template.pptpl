  "sceneGuide": {
    "lightDirection": "晴日漫射天空光为主，辅以前侧自然光，人物面部柔和受光，水面与浅色衣着反光提亮肤色",
    "shootingDistance": "2.5-4m",
    "background": "开阔湖面、水平线与蓝天白云留白，避免杂乱人群与杂乱前景",
    "props": [
      "浅色衣裙",
      "草帽（可选）"
    ],
    "bestTime": "晴日午后或清晨光线柔和时",
    "tips": [
      "人物多放画面中下部留出天空, 构图清爽透气。",
      "水岸风大, 抓拍裙摆与发丝飞扬更出氛围。",
      "逆光时略降曝光守住天空层次, 正面可轻补光。",
      "避免杂乱的湖岸植被与程人群入画。"
    ]
  },
