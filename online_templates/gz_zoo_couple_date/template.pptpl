  "sceneGuide": {
    "lightDirection": "明亮晴日的自然光，主光从画面左上方约 60° 柔柔打下，绿树与建筑形成均匀柔光，光比约 2:1，整体通透，皮肤保留自然质感",
    "shootingDistance": "1-3m（双人全身入画）",
    "background": "广州动物园的长颈鹿雕塑、条纹伞装置、心形鱼缸、植物绿墙、旋转木马等打卡点，避免杂乱人流入框",
    "props": [
      "长颈鹿雕塑",
      "条纹伞",
      "心形鱼缸",
      "比心"
    ],
    "bestTime": "晴日 09:00-11:00 或 15:00-17:00（光线柔和、游客少）",
    "tips": [
      "双人互动要真实，牵着手抓拍更自然，别硬摆。",
      "以动物雕塑为前景或后景，增加趣味与层次。",
      "衣着色系统一时髦，与蓝天绿树更搭。",
      "情侣动作要同步，眼神交汇或一起看镜头更有氛围。"
    ]
  },
