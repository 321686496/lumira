{
  "name": "lumira-server",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm build:shared && pnpm --parallel --filter @lumira/shared --filter @lumira/backend --filter @lumira/admin run dev",
    "dev:backend": "pnpm --filter @lumira/backend dev",
    "dev:admin": "pnpm --filter @lumira/admin dev",
    "build:shared": "pnpm --filter @lumira/shared build",
    "build:backend": "pnpm --filter @lumira/backend build",
    "test:backend": "pnpm --filter @lumira/backend test"
  },
  "packageManager": "pnpm@11.16.0+sha512.b767e9a98fc87aec0f42daefcd0e84941c2cdb45d73c4e1e68860fb2bdfdbe032ab592105479e5e05c237f740c8a5ffdbbb52385797ddc2296745a1bbb883e8d"
}
