# =============================================================================
# Lumira 后端 Nginx 反向代理配置示例
# =============================================================================
#
# 使用方式：
# 1. 复制此文件并重命名为你的站点配置（如 /etc/nginx/conf.d/lumira-api.conf）
# 2. 替换下面 <<...>> 占位符为你自己的值
# 3. nginx -t && nginx -s reload
#
# 前置条件：
# - nginx 容器与 lumira-backend 容器必须在同一个 docker network 中
#   （docker-compose.prod.yml 已配置 external network，见 NGINX_NETWORK 环境变量）
# - 后端容器在该网络中的主机名为 "lumira-backend"（docker-compose 服务名）
# =============================================================================

# 上游：后端容器（通过 docker 网络直接访问，无需暴露端口到宿主机）
upstream lumira_backend_upstream {
    # docker compose 服务名 "lumira-backend" 会自动在指定网络中解析为容器 IP
    server lumira-backend:3000;

    # 可选：长连接保持（减少每次请求的 TCP 握手开销）
    keepalive 32;
    keepalive_timeout 60s;
}

# 关键：正确区分「升级为 WebSocket」和「普通 HTTP 请求」的 Connection 头。
# 若对所有请求都写死 "upgrade"，会强制后端每次处理完就关闭连接，
# 导致上面的 upstream keepalive 完全失效，每张图片都重新建连 + 握手。
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      '';
}

# HTTP -> HTTPS 强制跳转（推荐生产开启）
server {
    listen 80;
    # 替换为你的域名或 IP
    server_name <<YOUR_API_DOMAIN>>;

    # 健康检查端点（用于 Docker healthcheck 或监控）
    location /healthz {
        proxy_pass http://lumira_backend_upstream/api/v1;
        access_log off;
    }

    # 其他所有请求跳转到 HTTPS
    location / {
        return 301 https://$host$request_uri;
    }
}

# HTTPS 主服务
server {
    listen 443 ssl http2;
    # 替换为你的域名
    server_name <<YOUR_API_DOMAIN>>;

    # HTTP/2：关键提速点。一张页面上同时加载 N 张缩略图时，
    # 所有图片在【同一条 TLS 连接】内多路复用，只握手一次，
    # 不再每张图单独握手（实测单次 TLS 握手就要约 2s）。
    # 注意：nginx 旧版（<1.25.1）用 "listen 443 ssl http2;"，
    # 新版（>=1.25.1）改成独立的 "http2 on;" 指令（listen 里的 http2 会被忽略，
    # 且新版本默认即开启 h2，无需重复配置）。
    # === SSL 证书 ===
    # 推荐使用 certbot 自动申请 Let's Encrypt 免费证书
    # certbot --nginx -d <<YOUR_API_DOMAIN>>
    # 申请完成后 certbot 会自动填充下面两行
    ssl_certificate     /etc/letsencrypt/live/<<YOUR_API_DOMAIN>>/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/<<YOUR_API_DOMAIN>>/privkey.pem;

    # === SSL 安全配置 ===
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_ciphers ECDHE-RSA-AES128-GCM-SHA256:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-RSA-AES128-SHA256:ECDHE-RSA-AES256-SHA384;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # === HSTS ===
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # === 请求体大小限制 ===
    # 后端目前主要是 JSON API，10MB 足够
    client_max_body_size 10m;

    # === 反向代理到后端容器 ===
    location / {
        proxy_pass http://lumira_backend_upstream;

        # 传递真实客户端信息给后端
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP        $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket 支持（如未来需要）：仅真正的 Upgrade 请求才带 upgrade，其余复用长连接
        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        # 超时设置（后端 SQLite 操作应很快，给足余量）
        proxy_connect_timeout 10s;
        proxy_send_timeout    60s;
        proxy_read_timeout    60s;

        # 长连接复用（配合 upstream keepalive）
        proxy_buffering off;
    }

    # === 健康检查端点（不记日志，方便监控频繁探活） ===
    location = /healthz {
        proxy_pass http://lumira_backend_upstream/api/v1;
        access_log off;
    }
}
